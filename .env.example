# Optional: map tile provider for the distributor map.
# Defaults to OpenStreetMap's public tiles, which are fine for low traffic.
# For production traffic use a provider with an API key, e.g. MapTiler:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
